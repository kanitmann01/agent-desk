{
  "schemaVersion": 2,
  "publisher": "agent-desk",
  "class": "declarative",
  "engines": {
    "dashboardHost": ">=0.1.0 <2.0.0"
  },
  "license": "MIT",
  "category": "finance",
  "minHost": ">=0.1.0",
  "id": "sales-delta-widget",
  "name": "Sales 24h Delta",
  "version": "0.2.0",
  "tags": [
    "sales",
    "pipeline",
    "daily-delta"
  ],
  "icon": "chart",
  "summary": "A Workbook tracker instance named Sales.",
  "description": "Sales 24h Delta is a Workbook tracker instance named Sales. You open the workbook and confirm the columns. No path, column, or target is assumed.",
  "highlights": [
    "Installs as the Sales instance of Workbook tracker.",
    "You open the file. Nothing is read until you confirm.",
    "The columns and any goal are yours, not a default."
  ],
  "permissions": {
    "filesystem": {
      "read": [],
      "write": []
    },
    "network": {
      "allow": []
    },
    "llm": {
      "allow": false
    },
    "shell": "none"
  },
  "activationEvents": [
    "onWidget:sales-delta",
    "onSchedule:0 * * * *"
  ],
  "contributes": {
    "widgets": [
      {
        "id": "sales-delta",
        "size": "2x1",
        "dataSource": {
          "type": "excel-watch"
        },
        "render": {
          "type": "ui-schema",
          "file": "widget.ui.json"
        }
      }
    ],
    "skills": [
      "skills/sales-summary/SKILL.md"
    ],
    "preferences": [
      {
        "name": "thresholdPct",
        "type": "number",
        "default": 5,
        "title": "Alert threshold (%)"
      }
    ]
  },
  "sample": "sample.json",
  "config": {
    "kinds": [
      "workbook"
    ],
    "aliasOf": "excel-report",
    "instanceName": "Sales",
    "good": "up"
  }
}
