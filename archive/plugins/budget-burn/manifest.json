{
  "schemaVersion": 2,
  "publisher": "agent-desk",
  "class": "declarative",
  "engines": {
    "dashboardHost": ">=0.1.0 <2.0.0"
  },
  "license": "MIT",
  "category": "finance",
  "minHost": ">=0.1.0",
  "id": "budget-burn",
  "name": "Budget Burn",
  "version": "0.2.0",
  "tags": [
    "budget",
    "spend",
    "burn"
  ],
  "icon": "clock",
  "summary": "A Workbook tracker instance named Budget.",
  "description": "Budget Burn is a Workbook tracker instance named Budget. You open the workbook and confirm the columns. No path, column, or target is assumed.",
  "highlights": [
    "Installs as the Budget instance of Workbook tracker.",
    "You open the file. Nothing is read until you confirm.",
    "The columns and any goal are yours, not a default."
  ],
  "permissions": {
    "filesystem": {
      "read": [],
      "write": []
    },
    "network": {
      "allow": []
    },
    "llm": {
      "allow": false
    },
    "shell": "none"
  },
  "activationEvents": [
    "onWidget:budget-burn",
    "onSchedule:0 7 * * *"
  ],
  "contributes": {
    "widgets": [
      {
        "id": "budget-burn",
        "size": "2x1",
        "dataSource": {
          "type": "excel-watch"
        },
        "render": {
          "type": "ui-schema",
          "file": "widget.ui.json"
        }
      }
    ]
  },
  "sample": "sample.json",
  "config": {
    "kinds": [
      "workbook"
    ],
    "aliasOf": "excel-report",
    "instanceName": "Budget",
    "good": "down"
  }
