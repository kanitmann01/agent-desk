{
  "type": "card",
  "title": "Outlook brief",
  "elements": [
    {
      "type": "metric",
      "binding": "messages",
      "label": "Active messages (24h)"
    },
    {
      "type": "text",
      "binding": "topEmailSubject",
      "label": "Most important email"
    },
    {
      "type": "text",
      "binding": "topEmailLine",
      "label": "From"
    },
    {
      "type": "text",
      "binding": "topEmailWhy",
      "label": "Why this one"
    },
    {
      "type": "list",
      "title": "Active threads",
      "rowsBinding": "threadRows"
    },
    {
      "type": "list",
      "title": "Reply starters",
      "rowsBinding": "replyOptions"
    },
    {
      "type": "text",
      "binding": "windowNote",
      "label": "Scope"
    }
  ]
}
