# Byte-exact files: hash pinning (release.lock) and cross-machine determinism
# depend on identical working-tree bytes everywhere.
* text=auto
*.py text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
# Shell scripts must stay LF: sh and Terminal.app break on CRLF, and the
# .command launchers are double-clicked on macOS where the exec bit (set in
# git, since Windows checkouts cannot preserve it) needs clean bytes.
*.command text eol=lf
*.sh text eol=lf
# The .eml mail fixtures are synthetic headers, read by the stdlib
# parser (line-ending agnostic); pinned so every checkout sees bytes.
*.eml text eol=lf
# Upstream licence texts are byte-pinned: THIRD-PARTY-NOTICES.md and
# licenses/third-party/README.md publish their sha256 and byte counts,
# so every checkout must see the LF bytes exactly as committed. The
# build copies frontend/public/licenses into the committed spa tree, so
# those copies pin too: a Windows rebuild must match the committed
# bundle byte for byte.
licenses/third-party/*.txt text eol=lf
frontend/public/licenses/*.txt text eol=lf
src/agentdesk/server/static/spa/licenses/*.txt text eol=lf
# The registry trees are digest-pinned: index.json publishes a sha256 per
# release and every install re-hashes the working tree, so each checkout
# must see the committed bytes. Pin LF under registry/ so core.autocrlf
# cannot rewrite text files on Windows (LICENSE and NOTICE have no
# extension rule of their own). eol=lf makes the checkout smudge a no-op
# for every registry file, and text=auto keeps the .pptx shells and .png
# thumbs out of newline conversion entirely.
registry/** text=auto eol=lf
# The same digest-pin hazard reaches extensionless LICENSE and NOTICE
# files outside registry/ (the root LICENSE travels inside the
# distribution bundle). The filename rules below cover any such file at
# any depth; inside registry/ the registry/** rule above already pins
# them, and the two rules agree so the overlap changes nothing.
LICENSE text eol=lf
NOTICE text eol=lf
