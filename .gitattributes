# Byte-exact files: hash pinning (release.lock) and cross-machine determinism
# depend on identical working-tree bytes everywhere.
* text=auto
*.py text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
