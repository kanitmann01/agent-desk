{
  "name": "agentdesk-dashboard-spa",
  "private": true,
  "version": "0.1.0",
  "description": "The Agent Desk dashboard as a React SPA. The build output is committed into src/agentdesk/server/static/spa so end users never need node; rebuild with npm ci && npm run build.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "clsx": "2.1.1",
    "motion": "12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "^3.2.4"
  }
}
